# Everything the app stores lives here: to-dos, calendar blocks, ideas,
# project memos, journal entries, focus sessions — and caldav_config.json,
# which holds an iCloud app-specific password in plain text. None of this
# belongs in a repository. The app recreates the folder on first run.
data/

# Python environment
.venv/
__pycache__/
*.pyc

# Build products — all regenerated by mac/build.sh
mac/phdapp
mac/makeicon
mac/AppIcon.icns
mac/AppIcon.iconset/

.DS_Store

# Superseded by the Mac app, and it hardcodes one machine's path.
# Kept on disk, left out of the repository.
launch.applescript
